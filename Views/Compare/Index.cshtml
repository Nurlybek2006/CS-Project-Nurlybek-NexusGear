@model CompareViewModel
<section class="page-intro container"><div class="section-kicker">SIDE BY SIDE / COMPARE</div><h1>Дұрыс таңдау<br><span>салыстырудан.</span></h1><p>Үш өнімге дейін салыстыр. Сипаттамалар санат бойынша көрсетіледі.</p></section><section class="container compare-page"><div class="compare-toolbar"><span>@Model.Products.Count / 3 ӨНІМ</span><a class="text-link" asp-controller="Catalog" asp-action="Index">Өнім қосу ↗</a><button class="text-button" data-clear="compare">Тазалау ×</button></div>@if(Model.Products.Count == 0){<div class="empty-state"><span>⇄</span><h2>Салыстыру тізімі бос</h2><p>Каталогтағы ⇄ батырмасын басып өнім таңда.</p><a class="button-primary" asp-controller="Catalog" asp-action="Index">Каталогқа өту ↗</a></div>}else{var sameCategory = Model.Products.Select(p=>p.Category).Distinct().Count() == 1;<div class="compare-scroll"><table class="compare-table"><thead><tr><th>СИПАТТАМА</th>@foreach(var p in Model.Products){<th><div class="compare-product"><img src="@p.ImageUrl" alt="@p.Name"><span class="eyebrow">@p.Brand</span><strong>@p.Name</strong><b>@p.Price.ToString("N0") ₸</b><button class="text-button" data-remove-compare="@p.Id">Алып тастау ×</button></div></th>}</tr></thead><tbody><tr><td>Санат</td>@foreach(var p in Model.Products){<td>@p.Category</td>}</tr><tr><td>Қолжетімділік</td>@foreach(var p in Model.Products){<td>@(p.IsAvailable ? "Қоймада" : "Жоқ")</td>}</tr>@if(sameCategory){<tr><td>Сипаттамасы</td>@foreach(var p in Model.Products){<td>@p.Specifications</td>}</tr>}else{<tr><td>Салыстыру ескертуі</td><td colspan="@Model.Products.Count">Әртүрлі санаттағы өнімдер: техникалық сипаттамалар тікелей салыстырылмайды.</td></tr>}</tbody></table></div>}</section>
