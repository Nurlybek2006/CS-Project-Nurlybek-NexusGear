@model IReadOnlyList<Product>
<section class="page-intro container"><div class="section-kicker">YOUR COLLECTION / FAVORITES</div><h1>Таңдаулы<br><span>құрылғылар.</span></h1><p>Сақтаған өнімдерің осы жерде көрсетіледі.</p></section><section class="container list-page">@if(Model.Count == 0){<div class="empty-state"><span>♡</span><h2>Таңдаулылар әзірге бос</h2><p>Каталогтан ұнаған өнімді жүрек белгісімен сақта.</p><a class="button-primary" asp-controller="Catalog" asp-action="Index">Каталогты ашу ↗</a></div>}else{<div class="product-grid">@foreach(var product in Model){<partial name="_ProductCard" model="product" />}</div>}</section>
