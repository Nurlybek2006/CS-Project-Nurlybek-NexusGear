@model ProductDetailsViewModel
<section class="container detail-page"><div class="breadcrumb"><a asp-controller="Home" asp-action="Index">Басты бет</a> / <a asp-controller="Catalog" asp-action="Index" asp-route-category="@Model.Product.Category">@Model.Product.Category</a> / @Model.Product.Name</div><div class="detail-grid"><div class="detail-visual"><span class="section-kicker">NEXUS OBJECT / @Model.Product.Id.ToString("000")</span><img src="@Model.Product.ImageUrl" alt="@Model.Product.Name"></div><div class="detail-copy"><div class="section-kicker">@Model.Product.Brand / @Model.Product.Category</div><h1>@Model.Product.Name</h1><p>@Model.Product.Description</p><div class="detail-spec">@Model.Product.Specifications</div><div class="detail-price"><strong>@Model.Product.Price.ToString("N0") ₸</strong><span class="stock @(Model.Product.IsAvailable ? "in-stock" : "out-stock")">● @(Model.Product.IsAvailable ? "Қоймада бар" : "Қоймада жоқ")</span></div><div class="detail-actions"><button class="button-primary favorite-action" data-favorite="@Model.Product.Id">♡ Таңдаулыға қосу</button><button class="button-secondary compare-action" data-compare="@Model.Product.Id">⇄ Салыстыру</button></div><div class="detail-note">Баға KZT валютасында көрсетілген. Өнім туралы ақпарат демонстрациялық каталог деректеріне негізделген.</div></div></div></section>
@if(Model.Related.Count > 0){<section class="featured-section"><div class="container"><div class="section-heading"><div><div class="section-kicker">КӨРІП ШЫҒЫҢЫЗ</div><h2>Ұқсас <span>өнімдер</span></h2></div></div><div class="product-grid">@foreach(var product in Model.Related){<partial name="_ProductCard" model="product" />}</div></div></section>}
