@model HomeViewModel
<section class="hero-section"><div class="hero-grid container"><div class="hero-copy"><div class="section-kicker"><span class="pulse-dot"></span> NEXT GENERATION HARDWARE / 2026</div><h1>БОЛАШАҚ<br>ТЕХНОЛОГИЯСЫ<br><span>ОСЫНДА.</span></h1><p class="hero-lead">Гейминг, шығармашылық және жоғары өнімділік үшін таңдаулы технологиялар әлемін аш.</p><div class="hero-actions"><a class="button-primary" asp-controller="Catalog" asp-action="Index">Каталогты зерттеу <span>↗</span></a><a class="button-quiet" asp-controller="PcBuilder" asp-action="Index"><span class="play-icon">▶</span> PC жинауды бастау</a></div><div class="hero-stats"><div><strong>@Model.ProductCount<span>+</span></strong><small>таңдаулы құрылғы</small></div><div><strong>08</strong><small>санат</small></div><div><strong>∞</strong><small>мүмкіндік</small></div></div></div><div class="hero-art"><div class="hero-orbit orbit-one"></div><div class="hero-orbit orbit-two"></div><div class="hero-glow"></div><img src="/images/hero-gpu.svg" alt="Nexus Gear графикалық карта визуалы"><div class="floating-spec spec-top"><span>RTX SERIES</span><strong>01 / POWER</strong></div><div class="floating-spec spec-bottom"><span>ENGINEERED FOR</span><strong>WHAT'S NEXT ↗</strong></div><div class="hero-index">NG—2026 <span>● LIVE SYSTEM</span></div></div></div><div class="hero-bottom container"><span>01 — ТЕХНОЛОГИЯЛАР ӘЛЕМІ</span><span>ТӨМЕНГЕ ЖЫЛЖЫТЫҢЫЗ ↓</span></div></section>
<div class="marquee"><div>PERFORMANCE <i>✳</i> PRECISION <i>✳</i> INNOVATION <i>✳</i> NEXUS GEAR <i>✳</i> PERFORMANCE <i>✳</i> PRECISION <i>✳</i> INNOVATION <i>✳</i> NEXUS GEAR <i>✳</i></div></div>
<section class="section-block container"><div class="section-heading"><div><div class="section-kicker">01 / БАҒЫТТАР</div><h2>Технологиялар<br><span>әлемін зертте</span></h2></div><a class="text-link" asp-controller="Catalog" asp-action="Index">Барлық санаттар <b>↗</b></a></div><div class="category-grid">@{var cats = new[]{("Видеокарталар","01","▧","Есептеу қуаты"),("Процессорлар","02","⌘","Жүйе өзегі"),("Ноутбуктер","03","▱","Қуат · мобильдік"),("Жедел жад","04","▥","Көп тапсырма"),("SSD","05","◈","Жылдам сақтау"),("Мониторлар","06","▣","Кең көкжиек"),("Периферия","07","⌁","Дәл басқару"),("Корпустар","08","⬡","Жинақ негізі")};} @foreach(var c in cats){<a class="category-tile" asp-controller="Catalog" asp-action="Index" asp-route-category="@c.Item1"><span class="category-no">@c.Item2 / CATEGORY</span><span class="category-icon">@c.Item3</span><h3>@c.Item1</h3><span class="category-note">@c.Item4 <b>↗</b></span></a>}</div></section>
<section class="featured-section"><div class="container"><div class="section-heading"><div><div class="section-kicker">02 / КУРАТОР ТАҢДАУЫ</div><h2>Таңдаулы<br><span>құрылғылар</span></h2></div><a class="text-link" asp-controller="Catalog" asp-action="Index">Каталогқа өту <b>↗</b></a></div><div class="product-grid">@foreach(var product in Model.Featured){<partial name="_ProductCard" model="product" />}</div></div></section>
<section class="builder-promo container"><div class="builder-promo-copy"><div class="section-kicker">03 / YOUR BUILD. YOUR RULES.</div><h2>Өзіңнің келесі<br><span>деңгейіңді құр.</span></h2><p>Үйлесімді бөлшектерді таңда. Жүйе сипаттамаларды тексеріп, жинағыңды есептейді.</p><a class="button-primary" asp-controller="PcBuilder" asp-action="Index">PC Builder ашу <span>↗</span></a></div><div class="builder-visual"><div class="builder-circle"><span>NG</span><i>✳</i></div><div class="builder-chip">CUSTOM SYSTEM<br><b>01 — 08 COMPONENTS</b></div></div></section>
<section class="closing-strip"><div class="container"><span class="section-kicker">NEXUS / GEAR</span><h2>Қуат. Дәлдік.<br><span>Сенің таңдауың.</span></h2><a class="button-secondary" asp-controller="Catalog" asp-action="Index">Зерттеуді бастау ↗</a></div></section>
