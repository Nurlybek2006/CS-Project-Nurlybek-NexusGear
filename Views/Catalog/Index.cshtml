@model CatalogViewModel
<section class="page-intro container"><div class="section-kicker">NEXUS GEAR / CATALOG</div><h1>Технологиялар<br><span>каталогы.</span></h1><p>Келесі жинағыңа лайық құрылғыны тап.</p></section>
<section class="catalog-layout container"><aside class="catalog-sidebar"><div class="filter-title">САНАТТАР <span>⌄</span></div><a class="filter-link @(Model.Category == null ? "active" : "")" asp-controller="Catalog" asp-action="Index">Барлығы <small>@Model.Products.Count()</small></a>@foreach(var category in Model.Categories){<a class="filter-link @(Model.Category == category ? "active" : "")" asp-controller="Catalog" asp-action="Index" asp-route-category="@category">@category <span>↗</span></a>}</aside><div class="catalog-main"><div class="catalog-toolbar"><form asp-controller="Catalog" asp-action="Index" class="catalog-search"><input type="hidden" name="category" value="@Model.Category"><input name="q" value="@Model.Query" placeholder="Атау, бренд немесе санат…"><button>Іздеу ↗</button></form><div class="toolbar-meta"><span>@Model.Products.Count() ӨНІМ</span><form method="get"><input type="hidden" name="q" value="@Model.Query"><input type="hidden" name="category" value="@Model.Category"><select name="sort" onchange="this.form.submit()"><option value="featured" selected="@(Model.Sort == "featured")">Ұсынылған</option><option value="price-asc" selected="@(Model.Sort == "price-asc")">Бағасы: арзаннан</option><option value="price-desc" selected="@(Model.Sort == "price-desc")">Бағасы: қымбаттан</option><option value="name" selected="@(Model.Sort == "name")">Атауы</option></select></form></div></div>@if(Model.Products.Count == 0){<div class="empty-state"><span>⌕</span><h2>Өнім табылмады</h2><p>Іздеу сөзіңді өзгертіп көр.</p><a class="button-secondary" asp-controller="Catalog" asp-action="Index">Сүзгіні тазалау</a></div>}else{<div class="product-grid catalog-products">@foreach(var product in Model.Products){<partial name="_ProductCard" model="product" />}</div>}</div></section>
