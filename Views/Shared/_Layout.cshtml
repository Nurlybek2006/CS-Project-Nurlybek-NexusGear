<!doctype html>
<html lang="kk" data-theme="dark">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080b12" /><title>@ViewData["Title"] | NEXUS GEAR</title>
    <script>try{document.documentElement.dataset.theme=localStorage.getItem('nexus-gear:theme:v1')||'dark'}catch{}</script>
    <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="site-header"><div class="header-inner"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">N</span><span>NEXUS <b>/ GEAR</b></span></a><button class="menu-toggle" aria-label="Мәзірді ашу">☰</button><nav class="main-nav"><a asp-controller="Home" asp-action="Index">Басты бет</a><a asp-controller="Catalog" asp-action="Index">Каталог</a><a asp-controller="PcBuilder" asp-action="Index">PC Builder</a><a asp-controller="Compare" asp-action="Index">Салыстыру <span class="counter" data-counter="compare">0</span></a><a asp-controller="Favorites" asp-action="Index">Таңдаулылар <span class="counter" data-counter="favorites">0</span></a></nav><div class="header-actions"><form class="header-search" asp-controller="Catalog" asp-action="Index"><input name="q" placeholder="Өнімді іздеу…" aria-label="Өнімді іздеу"><button aria-label="Іздеу">⌕</button></form><button class="icon-button theme-toggle" type="button" aria-label="Тақырыпты ауыстыру">◐</button></div></div></header>
<main>@RenderBody()</main>
<footer class="site-footer"><div class="container footer-inner"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">N</span><span>NEXUS <b>/ GEAR</b></span></a><p>Жаңа буын технологиялары. Ақылды таңдау.</p><span class="mono">© 2026 NEXUS GEAR · KZ</span></div></footer>
<div id="toast-region" class="toast-region" aria-live="polite"></div><div class="modal fade" id="quickViewModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content quick-modal" id="quickViewContent"></div></div></div>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)
</body></html>
