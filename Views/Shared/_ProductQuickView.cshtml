@model Product
<div class="quick-view-grid"><div class="quick-view-image"><img src="@Model.ImageUrl" alt="@Model.Name"></div><div class="quick-view-copy"><button type="button" class="quick-close" data-bs-dismiss="modal" aria-label="Жабу">×</button><span class="eyebrow">@Model.Brand · @Model.Category</span><h2>@Model.Name</h2><p>@Model.Description</p><div class="quick-spec">@Model.Specifications</div><strong class="price-large">@Model.Price.ToString("N0") ₸</strong><p class="stock in-stock">● @(Model.IsAvailable ? "Қоймада бар" : "Қоймада жоқ")</p><div class="d-flex gap-2"><a class="button-primary" href="/Product/Details/@Model.Id">Толығырақ <span>↗</span></a><button class="button-secondary favorite-action" data-favorite="@Model.Id">♡ Таңдаулы</button></div></div></div>
