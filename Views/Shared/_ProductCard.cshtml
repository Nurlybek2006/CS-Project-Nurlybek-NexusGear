@model Product
<article class="product-card" data-product-id="@Model.Id"><div class="product-visual"><a asp-controller="Product" asp-action="Details" asp-route-id="@Model.Id" aria-label="@Model.Name"><img src="@Model.ImageUrl" alt="@Model.Brand @Model.Name" loading="lazy"></a><div class="product-badges">@if(Model.IsNew){<span class="badge-new">ЖАҢА</span>}@if(!Model.IsAvailable){<span class="badge-unavailable">ЖОҚ</span>}</div><div class="product-quick-actions"><button class="mini-action favorite-action" data-favorite="@Model.Id" aria-label="Таңдаулыға қосу">♡</button><button class="mini-action compare-action" data-compare="@Model.Id" aria-label="Салыстыруға қосу">⇄</button><button class="mini-action quick-action" data-quick="@Model.Id" aria-label="Жылдам шолу">↗</button></div></div><div class="product-copy"><span class="eyebrow">@Model.Brand · @Model.Category</span><a class="product-name" asp-controller="Product" asp-action="Details" asp-route-id="@Model.Id">@Model.Name</a><div class="product-spec">@Model.Specifications</div><div class="product-card-bottom"><strong>@Model.Price.ToString("N0") <small>₸</small></strong><span class="stock @(Model.IsAvailable ? "in-stock" : "out-stock")">● @(Model.IsAvailable ? "Қоймада" : "Алдын ала тапсырыс")</span></div></div></article>
